# ============================================================
# spiderV5 后端配置文件示例
# 使用方法：复制本文件为 .env，然后根据实际环境修改下方配置
#   cp backend/.env.example backend/.env
# ============================================================

# ---------- 数据库配置 ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_DATABASE=warehouse_data

# ---------- 服务配置 ----------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# true / false
DEBUG=true
# 允许的跨域来源，多个用逗号分隔；* 表示全部允许
CORS_ORIGINS=*

# ---------- 爬虫配置 ----------
SPIDER_INTERVAL_MINUTES=30
SPIDER_TIMEOUT_SECONDS=30

# ---------- WMS 仓库接口 ----------
LOGIN_URL=https://example.com/user/login
QUERY_URL=https://example.com/api/warehouse/query

# ---------- 飞书共享表 ----------
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_SHEET_URL=

# ---------- 采购系统 ----------
PURCHASE_API_URL=
PURCHASE_API_KEY=

# ---------- DeepSeek LLM ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------- QR 码到件页面地址 ----------
QR_BASE_URL=http://localhost:8000

# ---------- 上传目录（可选）----------
# UPLOAD_DIR=./uploads
